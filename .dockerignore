# Build artifacts & deps (rebuilt inside the image)
_build/
deps/
cover/
doc/
*.beam
erl_crash.dump

# Editors / OS
.DS_Store
.elixir_ls/
.lexical/
.idea/
.vscode/
*.swp
*.swo

# Git / jj
.git/
.jj/

# Secrets / env templates — NEVER baked into an image
.env
.env.*
*.pem
*.key
secrets/
.envrc
.envrc.local

# Logs
*.log
*.log.*

# Giulia code-intelligence cache
.giulia/

# Spec-kit artifacts (docs, not code)
specs/
docs/

# Local GAN run output
local-gan-runs/
/tmp-gan/

# Python bytecode
__pycache__/
*.py[cod]

# F004 SPA — only exclude what the build stage rebuilds from source.
# The Dockerfile's build stage NEEDS ui/ source (package.json, src/,
# config files) to run `pnpm install && pnpm run build && pnpm run
# sync-to-priv`; the resulting `priv/static/admin/` is then captured
# in the staged release that the runtime stage COPYs from. So source
# files MUST be in the build context.
#
# Build outputs and dev/test artifacts stay excluded — they're either
# regenerated by the build stage (node_modules, dist, .vite) or
# unnecessary for both stages (coverage, playwright reports).
node_modules/
ui/node_modules/
ui/dist/
ui/.vite/
ui/coverage/
ui/playwright-report/
ui/test-results/

# Release builds use the coordinated three-source context prepared by
# scripts/prepare-release.py and docker-compose/fold-context.dockerignore.
# The enterprise checkout alone is not a complete release build context.
