{
  "$comment": "F004 extends F002 cedar_entity_schema; Cedar version 4.9.1 (pinned per F001 research D2). Loaded by the Gateway's Recurse.Gateway.Policy.Evaluator at boot. Schemas in cedarschema JSON format (human-friendly alternative: a .cedarschema text format; this JSON is canonical). Spec 009 (LLM API Proxy) adds the unqualified namespace below for the `invoke_tool` action + `ToolUse` resource type used by `Recurse.Gateway.LlmProxy.CedarToolUseGate`; the gate emits bare action/resource UIDs (`Action::\"invoke_tool\"`, `ToolUse::\"shell\"`) so the matching schema lives in the empty namespace.",
  "": {
    "entityTypes": {
      "User": {
        "$comment": "Spec 009 — principal entity for the LLM proxy's per-tool-use Cedar gate. Mirrors `CedarToolUseGate.encode_entities/2` shape.",
        "shape": {
          "type": "Record",
          "attributes": {
            "kind": {"type": "String", "required": true, "$comment": "one of: obo_human | service_account | autonomous"},
            "chatgpt_account_id": {"type": "String", "required": true, "$comment": "empty string when not a ChatGPT-OBO call"},
            "groups": {"type": "Set", "element": {"type": "String"}, "required": true}
          }
        }
      },
      "ToolUse": {
        "$comment": "Spec 009 — resource entity for tool-use intents. The id is the tool name (e.g. `shell`, `read_file`, `web_search`). Attributes are intentionally empty; per-call data flows via `context`.",
        "shape": {
          "type": "Record",
          "attributes": {}
        }
      }
    },
    "actions": {
      "Action::invoke_tool": {
        "$comment": "Spec 009 Sub-3.4 / T039-T044 — fired once per `ToolUseIntent` extracted from an LLM response stream. Context shape mirrors `CedarToolUseGate.build_cedar_context/2`. `tool_args` is inlined (Record) when under the per-tenant args-inline threshold (default 10KB); otherwise only `tool_args_hash` is exposed and policies must rely on hash allowlists.",
        "appliesTo": {
          "principalTypes": ["User"],
          "resourceTypes": ["ToolUse"],
          "context": {
            "type": "Record",
            "attributes": {
              "tool_args_hash": {"type": "String", "required": true, "$comment": "hex SHA-256 of canonicalized tool arguments"},
              "tool_args_size_bytes": {"type": "Long", "required": true},
              "model": {"type": "String", "required": true},
              "tenant": {"type": "String", "required": true},
              "session_id": {"type": "String", "required": true},
              "prompt_hash": {"type": "String", "required": true, "$comment": "hex SHA-256"},
              "response_so_far_hash": {"type": "String", "required": true, "$comment": "hex SHA-256"},
              "estimated_completion_tokens": {"type": "Long", "required": true},
              "cedar_bundle_hash": {"type": "String", "required": true, "$comment": "hex of bundle canonical_hash captured at call-start"},
              "upstream_domain": {"type": "String", "required": true},
              "transport": {"type": "String", "required": true, "$comment": "one of: wss | https_sse"},
              "started_at": {"type": "String", "required": true, "$comment": "ISO 8601 UTC timestamp"},
              "principal_kind": {"type": "String", "required": true, "$comment": "one of: obo_human | service_account | autonomous"},
              "chatgpt_account_id": {"type": "String", "required": true, "$comment": "empty string when not a ChatGPT-OBO call"},
              "principal_groups": {"type": "Set", "element": {"type": "String"}, "required": true},
              "parallel_tool_call_index": {"type": "Long", "required": true, "$comment": "-1 when sequential; >=0 for parallel-tool-calls position"}
            }
          }
        }
      }
    }
  },
  "Recurse": {
    "commonTypes": {
      "CorrelationContext": {
        "type": "Record",
        "attributes": {
          "tenant_id": {"type": "String", "required": true},
          "correlation_id": {"type": "String", "required": true},
          "timestamp": {"type": "Long", "required": true, "$comment": "Unix epoch seconds"},
          "client_ip": {"type": "String", "required": true}
        }
      },
      "BrowserSessionContext": {
        "$comment": "F004",
        "type": "Record",
        "attributes": {
          "tenant_id": {"type": "String", "required": true},
          "correlation_id": {"type": "String", "required": true},
          "timestamp": {"type": "Long", "required": true},
          "client_ip": {"type": "String", "required": true},
          "browser_session_id": {"type": "String", "required": true},
          "user_agent": {"type": "String", "required": false}
        }
      }
    },
    "entityTypes": {
      "Principal::Human": {
        "shape": {
          "type": "Record",
          "attributes": {
            "subject": {"type": "String", "required": true},
            "issuer": {"type": "String", "required": true},
            "display_name": {"type": "String", "required": false},
            "groups": {"type": "Set", "element": {"type": "String"}, "required": true},
            "recurse_role": {"type": "String", "required": true, "$comment": "one of: platform_operator | tenant_auditor | caller"},
            "tenant_id": {"type": "String", "required": true, "$comment": "F004 addition; single-tenant per deployment in F004"}
          }
        }
      },
      "Principal::ServiceAccount": {
        "shape": {
          "type": "Record",
          "attributes": {
            "subject": {"type": "String", "required": true},
            "issuer": {"type": "String", "required": true},
            "account_id": {"type": "String", "required": true},
            "scope": {"type": "Set", "element": {"type": "String"}, "required": true},
            "recurse_role": {"type": "String", "required": true},
            "tenant_id": {"type": "String", "required": true, "$comment": "F004 addition"}
          }
        }
      },
      "Principal::Autonomous": {
        "shape": {
          "type": "Record",
          "attributes": {
            "spiffe_id": {"type": "String", "required": false, "$comment": "null in Standalone; reserved for Governance shapes"},
            "subject": {"type": "String", "required": true, "$comment": "self-referential in Standalone"},
            "recurse_role": {"type": "String", "required": true},
            "tenant_id": {"type": "String", "required": true, "$comment": "F004 addition"}
          }
        }
      },
      "Resource::LLMEndpoint": {
        "shape": {
          "type": "Record",
          "attributes": {
            "model": {"type": "String", "required": true},
            "provider": {"type": "String", "required": true, "$comment": "e.g., openai"}
          }
        }
      },
      "Resource::AuditEndpoint": {
        "shape": {
          "type": "Record",
          "attributes": {
            "endpoint": {"type": "String", "required": true, "$comment": "e.g., /v1/audit/receipts"}
          }
        }
      },
      "Resource::PayloadBroker": {
        "shape": {
          "type": "Record",
          "attributes": {
            "run_id": {"type": "String", "required": true},
            "tenant_id": {"type": "String", "required": true}
          }
        }
      },
      "Resource::ConsoleSurface": {
        "$comment": "F004 — single virtual resource representing the audit console as a whole. Used by all UI / dashboard / chat / policy-* actions whose target is the console itself, not a specific receipt or payload.",
        "shape": {
          "type": "Record",
          "attributes": {
            "console_path": {"type": "String", "required": true, "$comment": "e.g., /admin/dashboard, /admin/policy-simulator"}
          }
        }
      }
    },
    "actions": {
      "Action::ChatCompletion": {
        "appliesTo": {
          "principalTypes": ["Principal::Human", "Principal::ServiceAccount", "Principal::Autonomous"],
          "resourceTypes": ["Resource::LLMEndpoint"],
