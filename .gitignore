# Secrets — never commit
.envrc
.envrc.local
.env
.env.*
# ...but the committed template the quickstart copies (spec 012 S1) is not a secret.
!.env.example
*.pem
*.key
secrets/
.credentials
.agent-auth.env
.agent-context/
.agent-home/

# Local editor / OS / tool cruft
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Elixir build artifacts
_build/
deps/
*.beam
erl_crash.dump
.elixir_ls/
.lexical/
cover/
doc/
.fetch
mix.lock.backup

# Rust build artifacts (NIFs under native/)
target/
*.so
*.dylib
*.dll
*.rlib
*.rs.bk

# Mix-generated OpenAPI artifacts (rebuild deterministically via `mix recurse.contracts.openapi`)
contracts/openapi.json

# Python bytecode from helper scripts (e.g., local-gan)
__pycache__/
*.py[cod]

# Local GAN run output (should live outside the repo, but belt and suspenders)
local-gan-runs/
/tmp-gan/

# jj internals — already excluded by git for colocated repos,
# but pin it defensively if anyone uses non-colocated layout
.jj/

# Python bytecode cache
.claude/skills/**/__pycache__/
**/__pycache__/

# Giulia code-intelligence daemon per-project cache + history
# (writes to .giulia/{cache,history}/ on first scan; daemon auto-generates
# a nested .giulia/.gitignore but the project-root entry keeps cruft out
# of `git status` anywhere it appears)
.giulia/

# US4 integration-test artifacts — mock-hec writes received HEC events
# here during `test/integration/us4_vector_forwarder_test.sh`. The dir
# itself is tracked via `.gitkeep`; the events file is regenerated per run.
test/integration/hec_events/events.ndjson

# F004 SPA — Node/TypeScript build artifacts
node_modules/
ui/dist/
ui/.vite/
ui/coverage/
ui/playwright-report/
ui/test-results/
# IMPORTANT (per F004 research D10): ui/src/lib/types.ts IS COMMITTED.
# CI runs `pnpm gen:types && git diff --exit-code ui/src/lib/types.ts`.
# Do NOT add it to .gitignore. Drift between schemas + types fails CI.

# F004 SPA — synced build output served by Gateway via Plug.Static
# (rebuilt by `pnpm run sync-to-priv` per research D9; never edited by hand)
apps/recurse_gateway/priv/static/admin/

# F004 SPA — local Monaco bundle synced from node_modules at build time
# (regenerated by `pnpm run copy:monaco`; B6 fix — see lib/configureMonacoLoader.ts)
ui/public/vs/

# Tier-config integrity sidecars are build-time artifacts (regenerated by
# scripts/compute-tier-config-hash.sh during release builds), not source.
config/reference/*.sha256

# Agent worktrees (per-dispatch temporary copies)
.claude/worktrees/

# Local-only .pen file backups created when an out-of-band sync (e.g.
# fixing a worktree-shadow .pen drift) needs to preserve both versions.
# Don't commit — these are recovery aids, not source of truth.
design/_backups/

# GAN run artifacts (large JSONL streams; never tracked)
docs/superpowers/gans/**/runs/**/events/*.jsonl
docs/superpowers/gans/**/runs/**/raw/*.jsonl

# Local agent state
.agents/
.specify/extensions/orchestrator/

# Internal business / pricing / customer docs — never committed.
# Per-customer pricing analysis, COGS, contract terms, named-prospect
# strategy. Lives on the operator's laptop only. Move to a private
# repo if multi-machine sync becomes necessary.
internal/

# The fold (apps/recurse_fold) — r5e kernel state. Throwaway by construction:
# the chain, CAS, exports and the fold node's own ed25519 keypair live here.
# NEVER the same directory as r5e-kernel/.r5e (the real genesis key).
apps/recurse_fold/.r5e-fold/
apps/recurse_fold/.r5e-demo/
apps/recurse_fold/fold-demo-verification.txt

# spec 012 quickstart — bin/r5e state (dev-login cookie jar)
.r5e/

# Rustler build output copied into priv by `mix compile` (recurse_cedar bin target);
# *.so is already ignored above, this is the companion CLI binary.
apps/recurse_shared/priv/native/cedar-canonical-hash

# Frozen local release build contexts (regenerated from JJ revisions).
.release-context/

# Scratch for the release smoke (scripts/smoke-release-compose.sh stages its policy copy here); the packer tripwire refuses it if tracked.
/tmp/
