# Recurse Gateway — env template (F002 T011).
# -------------------------------------------------------
# Copy this file to `.env.gateway` at the repo root, then replace every
# `REPLACE_ME` placeholder. Docker Compose loads it via `env_file:`.
#
#   cp docker-compose/gateway.env.example .env.gateway
#   $EDITOR .env.gateway
#
# The `.env.gateway` path is git-ignored (see .gitignore: `.env.*`).

# ---- AWS (StorageProvider + SecretsProvider) ----
# The IAM principal below must have:
#   - s3:PutObject,GetObject,HeadObject  on your payload bucket
#   - kms:Sign,GetPublicKey,DescribeKey  on your signing key
#   - secretsmanager:GetSecretValue      on the `refs:` secrets in tier-config.yaml
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME

# ---- LLM provider ----
# Required when llm_provider.api_key_ref in tier-config.yaml is `env://OPENAI_API_KEY`.
# If you route api_key_ref through AWS Secrets Manager instead, delete this line.
OPENAI_API_KEY=REPLACE_ME

# ---- Database (Postgres — from docker-compose.yaml postgres service) ----
# The hostname `postgres` resolves on the `recurse_net` Docker network.
DATABASE_URL=postgres://recurse:recurse@postgres:5432/recurse

# ---- Tier configuration ----
# Container-internal path; docker-compose.yaml mounts tier-config.yaml here.
RECURSE_TIER_CONFIG_PATH=/etc/recurse/tier-config.yaml

# ---- F004 T012: Audit Console — browser-session cookie envelope key ----
# Symmetric key for Plug.Crypto.MessageEncryptor sealing the browser-session
# cookie. MUST be ≥64 hex chars (32 bytes of entropy). Rotate by setting a
# secondary key in the runtime config; per browser_oidc_flow.md the
# BrowserSessionPlug supports primary + secondary key set so rotation is
# zero-downtime (mutation-only rotation per research D6).
# Generate: openssl rand -hex 64
GATEWAY_ADMIN_SESSION_SECRET_KEY_BASE=REPLACE_ME

# ---- F004 T012: Audit Console — Okta OIDC client (browser flow) ----
# Drives the /admin/login/start + /admin/login/callback PKCE flow at the
# Gateway-hosted callback URL. The client must be configured at your
# Okta tenant with the redirect URI:
#   https://<your-gateway-host>/admin/login/callback
# Per quickstart.md §1.4. For other OIDC providers (Auth0, Azure AD,
# Google Workspace), wire an analogous BROKER_OIDC_ISSUERS-equivalent
# block; F004 day-1 ships with Okta-shaped env-var names but the flow
# is provider-agnostic.
OKTA_CLIENT_ID=REPLACE_ME
OKTA_CLIENT_SECRET=REPLACE_ME

# ---- Internal JWT (broker-shaped, dogfood WorkOS path; F004 GAN-fix #1) ----
# When BROWSER_OIDC_PROVIDER=workos the gateway mints broker-shaped
# `X-Observed-Identity` JWTs in-process so Cedar-gated F004 endpoints work
# post-WorkOS-login. Mount the SAME ES256 PEM the broker uses
# (./scripts/gen-broker-key.sh writes it) and set
# `BROKER_JWT_SIGNING_KEY_PATH` to the container-internal path.
#
# `BROKER_JWT_AUDIENCE` MUST match the gateway's
# `principal_provider.expected_audience` in tier-config.yaml (defaults to
# `recurse-gateway-local`).
BROKER_JWT_SIGNING_KEY_PATH=/secrets/broker-signing-key.pem
BROKER_JWT_AUDIENCE=recurse-gateway-local
# Issuer string stamped onto the minted internal JWT. Audit-meaningful
# only — not used for JWKS discovery.
INTERNAL_JWT_ISSUER=https://gateway.dogfood.recurse.local/internal
# TTL bound for the WorkOS-path replay window. F004 FR-004 (broker
# JTI deny-list) is unwired on the WorkOS path; this TTL caps how long
# a leaked cookie stays usable. Default 900s (15 min).
INTERNAL_JWT_TTL_SECONDS=900

# ---- Browser OIDC provider selector ----
# `workos` (dogfood default) routes through the WorkOS adapter (no
# broker container). `oidc` / `broker` route through the F002/F004
# RFC-8693 broker.
BROWSER_OIDC_PROVIDER=workos

# ---- WorkOS adapter env (when BROWSER_OIDC_PROVIDER=workos) ----
WORKOS_API_KEY=REPLACE_ME
WORKOS_CLIENT_ID=REPLACE_ME
WORKOS_REDIRECT_URI=https://gateway.dogfood.recurse.local/admin/login/callback
WORKOS_DEFAULT_ORGANIZATION_ID=REPLACE_ME
WORKOS_API_BASE=https://api.workos.com

# ---- Release env ----
MIX_ENV=prod
