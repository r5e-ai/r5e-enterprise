# Recurse Standalone Identity Broker — env template (F002 T011).
# -------------------------------------------------------------------
# Copy this file to `.env.broker` at the repo root, then replace every
# `REPLACE_ME` placeholder. Docker Compose loads it via `env_file:`.
#
#   cp docker-compose/broker.env.example .env.broker
#   $EDITOR .env.broker
#
# The `.env.broker` path is git-ignored (see .gitignore: `.env.*`).

# ---- JWT signing key (mints X-Observed-Identity JWTs) ----
# Generate with `./scripts/gen-broker-key.sh` — writes ES256 keypair to
# ./secrets/broker-signing-key.pem (private) and .pub.pem (public).
# docker-compose.yaml mounts this file read-only at /secrets/.
BROKER_JWT_SIGNING_KEY_PATH=/secrets/broker-signing-key.pem

# ---- Minted JWT audience ----
# MUST match the Gateway's `principal_provider.expected_audience` in
# tier-config.yaml. Defaults to `recurse-gateway-local` for the reference
# compose stack.
BROKER_JWT_AUDIENCE=recurse-gateway-local

# ---- Upstream OIDC issuer(s) ----
# Comma-separated list of OIDC issuer URLs the broker trusts. Must serve a
# `/.well-known/openid-configuration` document.
# Replace with your Okta/Auth0/Azure-AD/Google-Workspace tenant URL.
BROKER_OIDC_ISSUERS=https://your-tenant.okta.com

# ---- Role mapping config ----
# Container-internal path; docker-compose.yaml mounts broker-role-mapping.yaml here.
BROKER_ROLE_MAPPING_PATH=/etc/recurse/broker/role-mapping.yaml

# ---- F004 T012: Audit Console — browser-flow login routes ----
# Enables the broker's GET /login/start + GET /login/callback PKCE entry
# points used by the F004 console. Default: false (broker remains
# RFC-8693-only for non-console deployments). Set true to enable.
# See contracts/browser_oidc_flow.md for the full flow; the Gateway hosts
# /admin/login/* on its own origin while the broker provides the actual
# OIDC integration + token-exchange minting.
BROKER_LOGIN_ENABLED=true

# ---- Release env ----
MIX_ENV=prod
