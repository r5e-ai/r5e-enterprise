{
  "group": "gateway.r5e.io",
  "kind": "LlmCall",
  "version": "v1alpha1",
  "substrate": "event",
  "naming": {
    "mode": "content"
  },
  "description": "One request to a model: who asked, which model, with which prompt. Parameter values are strings, integers, or booleans; a floating-point parameter such as a temperature is recorded as its decimal string.",
  "schema": {
    "required": [
      "model",
      "prompt"
    ],
    "properties": {
      "model": {
        "type": "string"
      },
      "prompt": {
        "type": "ref",
        "ref": {
          "kind": "gateway.r5e.io/v1alpha1/Prompt"
        }
      },
      "provider": {
        "type": "string"
      },
      "upstreamHost": {
        "type": "string"
      },
      "transport": {
        "type": "string",
        "enum": [
          "https",
          "https-sse",
          "wss"
        ]
      },
      "apiFormat": {
        "type": "string"
      },
      "requestPath": {
        "type": "string"
      },
      "session": {
        "type": "ref",
        "ref": {
          "kind": "gateway.r5e.io/v1alpha1/AgentSession"
        }
      },
      "sourceIds": {
        "type": "object",
        "properties": {
          "session": {
            "type": "string"
          },
          "run": {
            "type": "string"
          },
          "turn": {
            "type": "string"
          },
          "step": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "startedAt": {
        "type": "string"
      },
      "tools": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "parameters": {
        "type": "object",
        "values": {
          "type": [
            "string",
            "integer",
            "boolean"
          ]
        }
      },
      "gatewayContext": {
        "type": "object",
        "properties": {
          "principal_id": {
            "type": "string"
          },
          "principal_kind": {
            "type": "string"
          },
          "principal_source": {
            "type": "string"
          },
          "chatgpt_account_id": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "tenant": {
            "type": "string"
          },
          "session_id": {
            "type": "string"
          },
          "prompt_hash": {
            "type": "string"
          },
          "response_so_far_hash": {
            "type": "string"
          },
          "cedar_bundle_hash": {
            "type": "string"
          },
          "upstream_domain": {
            "type": "string"
          },
          "transport": {
            "type": "string"
          },
          "started_at": {
            "type": "string"
          },
          "tool_args_hash": {
            "type": "string"
          },
          "estimated_completion_tokens": {
            "type": "integer"
          },
          "parallel_tool_call_index": {
            "type": "integer"
          },
          "tool_args_size_bytes": {
            "type": "integer"
          },
          "principal_groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "principal_id",
          "principal_kind",
          "tenant",
          "model"
        ],
        "additionalProperties": false
      }
    },
    "additionalProperties": false,
    "nonEmpty": [
      "model"
    ]
  },
  "epistemicScope": {
    "claims": [
      "the recorded actor asked model `model` to complete the prompt at `prompt`, at the recorded position on the chain",
      "the key recorded as the actor signed this request over its canonical bytes, and the authority it cited resolved, link by link, to a root on this same chain \u2014 both re-derivable offline from the bundle alone"
    ],
    "doesNotClaim": [
      "that the provider received it",
      "that a response occurred (see LlmResponse)",
      "that any person, office, or organization holds the key that signed \u2014 the record binds the act to a key and the key to the authority it acted under, and neither to anyone; a reader who wants a name pins a root key and owns the pin",
      "that gatewayContext client identity or groups were cryptographically authenticated; these are observations signed by the gateway service, distinct from the admission signer"
    ]
  },
  "predicates": []
}
