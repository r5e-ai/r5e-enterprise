# r5e-enterprise local quickstart — per-checkout settings.
#
#   ./bin/r5e init      # copies this file to .env and fills the secrets
#
# Everything the gateway needs that is NOT a secret or a preference is set
# directly in docker-compose.yaml. `.env` is git-ignored.

# --- secrets (bin/r5e init generates these with `openssl rand -hex 32`) ---
# Encrypts the r5e_session browser cookie. Must be >= 32 chars and must NOT
# be left at this placeholder: the gateway container refuses to start
# (its entrypoint prints one line naming `bin/r5e init` and exits), and the
# release itself raises on a short value. If you copied this file by hand
# instead of running `bin/r5e init`, paste `openssl rand -hex 32` output
# here before `docker compose up`.
SECRET_KEY_BASE=REPLACE_ME_openssl_rand_hex_32
# Reserved for the admin-session envelope key (F004 T012). The release
# currently derives that key from SECRET_KEY_BASE; kept so the name is
# already in place when the two are split.
GATEWAY_ADMIN_SESSION_SECRET_KEY_BASE=REPLACE_ME_openssl_rand_hex_32
# Compose-internal Postgres password (not reachable from the host).
POSTGRES_PASSWORD=recurse

# --- preferences ---
# Tenant id stamped on every receipt. Any non-empty string; ULIDs by
# convention.
R5E_TENANT_ID=01TEN_LOCAL
# Attestation signing key algorithm for the local PEM signer:
#   es256   (default) — same family as the KMS signer; the console's
#                       "Verify locally" and recurse-verify both check it.
#   ed25519           — matches r5e-core. NOT verifiable yet: the console
#                       reports the signature step as unsupported_algorithm
#                       (not a failure, not checked) and recurse-verify
#                       cannot verify the export offline. Receipts are still
#                       signed and ledgered; only verification is missing.
R5E_LOCAL_SIGNING_ALG=es256
# POST /admin/test/login (no IdP). Local convenience; keep true for the
# quickstart, set false if this stack is reachable by anyone but you.
R5E_DEV_LOGIN_ENABLED=true
# Host ports published by compose. Change if 4000 / 4443 are taken on your
# machine; bin/r5e follows R5E_GATEWAY_PORT.
R5E_GATEWAY_PORT=4000
R5E_PROXY_PORT=4443
# Gateway log level (debug|info|notice|warning|error). `debug` also logs every
# database write with its parameters into `docker compose logs`.
#LOGGER_LEVEL=info
# Origin the dashboard is served from (JWT audience/issuer derive from it).
# Defaults to http://localhost:${R5E_GATEWAY_PORT}; set only for another host.
#R5E_PUBLIC_HOSTNAME=http://localhost:4000

# ---- LLM proxy upstreams (spec 012 S2) ----
# Comma list of presets seeded at boot (anthropic, openai_api). Claude Code needs `anthropic`.
R5E_LLM_PROXY_UPSTREAMS=anthropic
# Requests whose Host header is the gateway itself (ANTHROPIC_BASE_URL mode) go here.
# Set to `none` to require Host-header routing only (the Codex MITM shape).
R5E_LLM_PROXY_DEFAULT_UPSTREAM_HOST=api.anthropic.com
# A request whose Host header matches no configured upstream is refused
# (ERR_NO_UPSTREAM_CONFIG); `true` sends it to the default upstream instead.
#R5E_LLM_PROXY_FALLBACK_UNKNOWN_HOSTS=false

# ---- policy from git (spec 012 S5) ----
# Off by default: the gateway serves ./policy/bundle.cedar and reloads it
# within R5E_POLICY_BUNDLE_POLL_MS when the file changes. To pull the
# bundle from a git repo instead, set the URL and start with the profile:
#   docker compose --profile git-policy up -d
# Start your repo from policy-starter/ in this checkout.
# (Placeholder: an r5e-hosted starter repo URL will be offered here once
# it exists; until then copy policy-starter/ into a repo of your own.)
#R5E_POLICY_GIT_URL=https://gitlab.com/your-org/r5e-policy.git
# Branch or tag to follow (a full commit sha also works).
#R5E_POLICY_GIT_REF=main
# File inside the repo that becomes /policy/bundle.cedar.
#R5E_POLICY_GIT_PATH=policy/bundle.cedar
# Seconds between fetches.
#R5E_POLICY_GIT_INTERVAL=30
# Private https repo: a read-only token (GitLab project access token with
# `read_repository`; GitHub fine-grained PAT with Contents: read). Lives in
# this file only; the sidecar hands it to git through a credential helper
# and never prints it. Username defaults to `oauth2` (GitLab); GitHub
# accepts any username with a PAT.
#R5E_POLICY_GIT_TOKEN=
#R5E_POLICY_GIT_USERNAME=oauth2
# Milliseconds between bundle-file stat checks in the gateway (0 = SIGHUP only).
#R5E_POLICY_BUNDLE_POLL_MS=5000

# ---- Payload retention (spec 012 S6b) ----
# Keep the exact request and response bytes each receipt hashes, content-addressed in
# the CAS volume, so an evidence export can include them and the verifier can check
# them. They contain prompt content. Default in the release is false; compose sets true.
R5E_RETAIN_PAYLOADS=true
# Per-direction cap; over it nothing is kept for that direction and the export manifest
# says payload_retention: truncated.
# R5E_RETAIN_PAYLOADS_MAX_BYTES=8388608
