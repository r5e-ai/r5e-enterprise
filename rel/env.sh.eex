#!/bin/sh
# Mix sources this for every launcher invocation, including direct docker-exec
# RPCs, before resolving RELEASE_COOKIE. Never package a build-time cookie.
# Containers persist /secrets; extracted releases default to var/secrets and
# may select a mounted path with R5E_RELEASE_COOKIE_PATH on every invocation.
r5e_cookie_fail() {
  echo "ERROR: release cookie $1" >&2
  exit 1
}

if [ "${RELEASE_COOKIE+x}" = x ]; then
  [ -n "$RELEASE_COOKIE" ] || r5e_cookie_fail "override is empty"
else
  case "${RELEASE_COMMAND:-}" in
    start|start_iex|daemon|daemon_iex|eval|rpc|remote|restart|stop|pid)
      if [ -d /secrets ]; then
        r5e_cookie_default=/secrets/erlang.cookie
      else
        r5e_cookie_default="$RELEASE_ROOT/var/secrets/erlang.cookie"
      fi
      r5e_cookie_path="${R5E_RELEASE_COOKIE_PATH:-$r5e_cookie_default}"
      case "$r5e_cookie_path" in
        /*) ;;
        *) r5e_cookie_fail "path must be absolute" ;;
      esac
      [ ! -L "$r5e_cookie_path" ] || r5e_cookie_fail "file must not be a symlink"
      if [ ! -e "$r5e_cookie_path" ]; then
        case "$RELEASE_COMMAND" in
          start|start_iex|daemon|daemon_iex|eval)
            # A same-directory hard link publishes complete bytes without
            # replacing another invocation's winner. The subshell contains
            # umask/trap changes; neither the random bytes nor paths are logged.
            (
              umask 077
              r5e_cookie_dir=$(dirname "$r5e_cookie_path")
              mkdir -p "$r5e_cookie_dir" || exit 1
              r5e_cookie_tmp=$(mktemp "$r5e_cookie_dir/.erlang.cookie.XXXXXX") || exit 1
              trap 'rm -f "$r5e_cookie_tmp"' EXIT HUP INT TERM
              openssl rand -hex 32 > "$r5e_cookie_tmp" || exit 1
              chmod 600 "$r5e_cookie_tmp" || exit 1
              ln "$r5e_cookie_tmp" "$r5e_cookie_path" 2>/dev/null || [ -f "$r5e_cookie_path" ]
            ) || r5e_cookie_fail "could not be initialized"
            ;;
          *) r5e_cookie_fail "file is missing; refusing control command" ;;
        esac
      fi
      [ ! -L "$r5e_cookie_path" ] && [ -f "$r5e_cookie_path" ] && [ -r "$r5e_cookie_path" ] ||
        r5e_cookie_fail "file is not a readable regular file"
      [ -n "$(find "$r5e_cookie_path" -prune -type f -perm 0600 -print)" ] ||
        r5e_cookie_fail "file permissions must be 0600"
      RELEASE_COOKIE=$(cat "$r5e_cookie_path") || r5e_cookie_fail "file could not be read"
      [ "${#RELEASE_COOKIE}" -eq 64 ] || r5e_cookie_fail "file has invalid contents"
      case "$RELEASE_COOKIE" in
        *[!0123456789abcdef]*) r5e_cookie_fail "file has invalid contents" ;;
      esac
      ;;
    *)
      # Mix still resolves a cookie for version/help/unknown commands, but
      # these never start or contact a VM. Avoid creating deployment state.
      RELEASE_COOKIE=r5e_no_vm_command
      ;;
  esac
fi
export RELEASE_COOKIE
unset r5e_cookie_default r5e_cookie_path
